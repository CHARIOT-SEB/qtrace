# Copy to .env.local for development, and .env.production for the GitHub Pages build.
# Both values are public by design - the anon key only grants what row-level
# security allows. Never put the service_role key in this repo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
